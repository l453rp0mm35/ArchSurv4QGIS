t; = 'G51' THEN 'soil_core_sample'&#xa;WHEN &quot;point_prop&quot; = 'H51' THEN 'soil_monolith_sample'&#xa;WHEN &quot;point_prop&quot; = 'I51' THEN 'soil_kubiena_sample'&#xa;WHEN &quot;point_prop&quot; = 'J51' THEN 'soil_waterlogged_sample'&#xa;WHEN &quot;point_prop&quot; = 'K51' THEN 'excav.specif.meth.1'&#xa;WHEN &quot;point_prop&quot; = 'L51' THEN 'excav.specif.meth.2'&#xa;WHEN &quot;point_prop&quot; = 'M51' THEN 'excav.specif.meth.3'&#xa;WHEN &quot;point_prop&quot; = 'N51' THEN 'excav.specif.meth.4'&#xa;WHEN &quot;point_prop&quot; = 'O51' THEN 'excav.specif.meth.5'&#xa;WHEN &quot;point_prop&quot; = 'P51' THEN 'excav.specif.meth.6'&#xa;WHEN &quot;point_prop&quot; = 'Q51' THEN 'excav.specif.meth.7'&#xa;WHEN &quot;point_prop&quot; = 'R51' THEN 'excav.specif.meth.8'&#xa;WHEN &quot;point_prop&quot; = 'S51' THEN 'excav.specif.meth.9'&#xa;WHEN &quot;point_prop&quot; = 'T51' THEN 'excav.specif.meth.10'&#xa;WHEN &quot;point_prop&quot; = 'U51' THEN 'excav.specif.meth.11'&#xa;WHEN &quot;point_prop&quot; = 'V51' THEN 'excav.specif.meth.12'&#xa;WHEN &quot;point_prop&quot; = 'W51' THEN 'excav.specif.meth.13'&#xa;WHEN &quot;point_prop&quot; = 'X51' THEN 'excav.specif.meth.14'&#xa;WHEN &quot;point_prop&quot; = 'Y51' THEN 'excav.specif.meth.15'&#xa;WHEN &quot;point_prop&quot; = 'Z51' THEN 'excav.specif.meth.16'&#xa;END" name="static_value"/>
          </Option>
        </Option>
