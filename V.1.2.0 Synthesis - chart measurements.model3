    <Option type="Map">
      <Option type="QString" value="150,150,150,255" name="color"/>
      <Option type="QString" value="ArchSurv-String Parser 1" name="component_description"/>
      <Option type="double" value="220.3304603907769" name="component_height"/>
      <Option type="double" value="287.15610450271913" name="component_pos_x"/>
      <Option type="double" value="1074.7415211737462" name="component_pos_y"/>
