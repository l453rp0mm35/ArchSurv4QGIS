      <Option type="double" value="324.7442248978942" name="component_width"/>
      <Option type="bool" value="true" name="outputs_collapsed"/>
      <Option type="bool" value="true" name="parameters_collapsed"/>
      <Option type="QString" value="{e920b6fb-9967-44ca-9402-734fe42e42f8}" name="uuid"/>
    </Option>
    <Option type="Map">
      <Option type="QString" value="" name="color"/>
      <Option type="QString" value="Polygon Generation #2" name="component_description"/>
      <Option type="double" value="902.8291630344006" name="component_height"/>
      <Option type="double" value="2239.2489337914285" name="component_pos_x"/>
      <Option type="double" value="3360.3782009264487" name="component_pos_y"/>
      <Option type="double" value="325.4249812397443" name="component_width"/>
