    <Option type="Map">
      <Option type="QString" value="237,222,108,112" name="color"/>
      <Option type="QString" value="Branching: Mirror Polygon geometries to polylines" name="component_description"/>
      <Option type="double" value="227.9848750945653" name="component_height"/>
      <Option type="double" value="1729.4959988183202" name="component_pos_x"/>
      <Option type="double" value="3546.4328460521283" name="component_pos_y"/>
      <Option type="double" value="322.79213071736837" name="component_width"/>
      <Option type="bool" value="true" name="outputs_collapsed"/>
