            <Option type="QString" value="CASE&#xa;WHEN &quot;shptype&quot; = '1' THEN 'height'&#xa;WHEN &quot;shptype&quot; = '51' THEN 'sample'&#xa;WHEN &quot;shptype&quot; = '61' THEN 'height'&#xa;WHEN &quot;shptype&quot; = '71' THEN 'find'&#xa;WHEN &quot;shptype&quot; = '81' THEN 'photogrammetry'&#xa;WHEN &quot;shptype&quot; = '0' THEN 'section'&#xa;WHEN &quot;shptype&quot; = '91' THEN 'fixed_point'&#xa;WHEN &quot;shptype&quot; is NULL Then 'station_setup'&#xa;END" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
