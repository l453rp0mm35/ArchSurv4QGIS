      <Option type="QString" value="" name="color"/>
      <Option type="Map" name="comment">
        <Option type="QString" value="166,206,227,255" name="color"/>
        <Option type="QString" value="Pseudo Temporal Datum&#xa;&#xa;T1. &amp; T.2. Generation of &quot;maxHtemp&quot; and &quot;minHtemp&quot; pseudo dates for the QGIS temporal controller in five steps each:&#xa;&#xa;1.  Make height positive and year-like:&#xa;   &quot;minH&quot; + 1000 → e.g.  99.876 + 1000 = 1099.876&#xa;2.  Convert to string:&#xa;   Enables text operations → '1099.876'&#xa;3.  Extract year:&#xa;   First 4 characters → '1099.876' → year '1099'&#xa;4.  Determine month:&#xa;   Decimal part ('1099.876') → month '876'&#xa;   Map 0–999 to months in 100-steps:&#xa;   (0–99 → Jan, 100–199 → Feb, …, 800–899 → Sep, 900–999 → Oct)&#xa;5.  Create date:&#xa;   make_date'(1099, 9, 1)' → 01-Sep-1099&#xa;Example:&#xa;&quot;minH&quot; = '99.876' m → &quot;minHtemp&quot;: '01-Sep-1099'&#xa;→ Year ≈ elevation (m), month ≈ decimal part, day fixed (1).&#xa;" name="component_description"/>
        <Option type="double" value="247.78421037681986" name="component_height"/>
        <Option type="double" value="742.339938721819" name="component_pos_x"/>
        <Option type="double" value="1574.9069322015398" name="component_pos_y"/>
        <Option type="double" value="421.30050674565996" name="component_width"/>
        <Option type="bool" value="true" name="outputs_collapsed"/>
        <Option type="bool" value="true" name="parameters_collapsed"/>
      </Option>
