            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="make_date(&#xa;    to_int(substr(to_string(&quot;minH&quot; + 1000), 1, 4)),&#xa;    CASE&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 100 THEN 1&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 200 THEN 2&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 300 THEN 3&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 400 THEN 4&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 500 THEN 5&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 600 THEN 6&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 700 THEN 7&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 800 THEN 8&#xa;        WHEN to_int(right(rpad(to_string(&quot;minH&quot; + 1000), 8, '0'), 3)) &lt; 900 THEN 9&#xa;        ELSE 10&#xa;    END,&#xa;    1&#xa;)" name="static_value"/>
