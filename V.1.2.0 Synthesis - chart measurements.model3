  <Option type="Map" name="help">
    <Option type="QString" value="Thomas Leutgeb,  Stadtarchäologie Wien" name="ALG_CREATOR"/>
    <Option type="QString" value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'.AppleSystemUIFont'; font-size:13pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-weight:600;&quot;>ArchSurv4QGIS&lt;/span> &lt;span style=&quot; font-weight:600;&quot;>Synthesis&lt;/span> is an open source solution for automated archaeological feature drawings from in-field GNSS / totalstation point measurements via QGIS.&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; background-color:transparent;&quot;>It is designed as an adjustable &amp;quot;.model3&amp;quot; algorithm pipeline.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; font-weight:600; color:#1f2328;&quot;>AS4QGIS Synthesis&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f2328;&quot;> works on the basis of point data exported as delimited text from a surveying device.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f2328;&quot;>It processes 10-character pointID-strings: e. g. '&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#33a02c;&quot;>0001&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#de0f12;&quot;>A&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f78b4;&quot;>03&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#969696;&quot;>001&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f2328;&quot;>'&lt;/span>&lt;/p>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#33a02c;&quot;>feature&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;> '&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#000000;&quot;>1&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;>'&lt;/span>&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:4px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#de0f12;&quot;>line container&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;> / &lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#de0f12;&quot;>point property&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;> 'A'&lt;/span>&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:4px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f78b4;&quot;>shape type&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;> '03'&lt;/span>&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:4px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#969696;&quot;>sequence number&lt;/span>&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; color:#1f2328;&quot;> '001'&lt;/span>&lt;/li>&lt;/ul>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:4px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f2328;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt;&quot;>Depending on the entered &amp;quot;&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>shape type&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;>&amp;quot;, AS4QGIS generates four output datasets:&lt;/span>&lt;/p>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>polygons&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>polylines&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>pointdata&lt;/li>&lt;/ul>&#xa;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;>&lt;li style=&quot; font-size:12pt;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>vertices&lt;/li>&lt;/ul>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Noto Sans','Helvetica','Arial','sans-serif','Apple Color Emoji','Segoe UI Emoji'; font-size:12pt; color:#1f2328;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:14pt; font-weight:600;&quot;>Shape Type Spectrum&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>feature&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '01' - heights, '02' - polyline, '03' - polygon&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>sample&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '51' - sample point, '52' - sample polyline, '53' - sample polygon&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>posthole&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '61' - buffered point measurement&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>finds&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '71' - find point, '72' - find polyline, '73' - find polygon&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>3D&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> &lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>markers&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '81' - 3D marker point&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>trench&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '91' - fixed point, '92' - trench polyline, '93' trench polygon&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>section&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> &lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>nails&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;> | '00' - section nail point&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; font-size:12pt; background-color:transparent;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:14pt; font-weight:600;&quot;>Point Properties&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt;&quot;>While letters act as line containers for polyline and polygon measurements, sample, posthole, and finds point measurements can be assigned point properties using letters.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600; font-style:italic;&quot;>sample&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>If ‘A’ is entered as point property for a sample measurement the property is considered ‘not declared’.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>'&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>A&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - undeclared-sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>B&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - brick-sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>C&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - c14-sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>D&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - dendro-sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>E&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_bulk_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>F&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_block_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>G&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_core_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>H&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_monolith_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>I&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_kubiena_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>J&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - soil_waterlogged_sample; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>K&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.1; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>L&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.2; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>M&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.3; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>N&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.4; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>O&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.5; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>P&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.6; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Q&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.7; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>R&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.8; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>S&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.9; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>T&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.10; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>U&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.11; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>V&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.12; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>W&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.13; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>X&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.14; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Y&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.15; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Z&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.meth.16&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; font-size:12pt; background-color:transparent;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600; font-style:italic;&quot;>posthole&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>It is only mandatory to specify the point property in the case of plug hole measurements (shape type ‘61’). Based on a central measurement, the model generates a buffer with the diameter specified by the point property.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>'&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>A&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 1 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>B&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 2 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>C&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 3 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>D&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 4 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>E&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 5 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>F&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 6 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>G&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 7 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>H&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 8 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>I&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 9 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>J&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 10 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>K&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 11 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>L&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 12 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>M&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 13 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>N&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 14 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>O&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 15 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>P&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 16 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Q&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 17 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>R&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 18 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>S&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 19 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>T&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 20 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>U&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 21 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>V&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 22 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>W&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 23 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>X&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 24 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Y&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 25 cm; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Z&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - 26 cm&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; font-weight:600; font-style:italic;&quot;>finds&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>If ‘A’ is entered as point property for a finds measurement the property is considered ‘not declared’.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>'&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>A&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - undeclared; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>B&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - metal; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>C&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - coin; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>D&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - stone_object; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>E&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - silex; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>F&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - iron; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>G&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - glass; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>H&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - homo; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>I&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - animal_bones; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>J&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - architectural_ceramics; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>K&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - ceramics; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>L&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - burnt_daub; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>M&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - mortar; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>N&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - slag; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>O&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - organic; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>P&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.1; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Q&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.2; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>R&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.3; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>S&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.4; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>T&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.5; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>U&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.6; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>V&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.7; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>W&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.8; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>X&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.9; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Y&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - excav.specif.cat.10; '&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; background-color:transparent;&quot;>Z&lt;/span>&lt;span style=&quot; font-size:12pt; background-color:transparent;&quot;>' - misc&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; font-size:12pt; background-color:transparent;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:14pt; font-weight:600;&quot;>Style Files&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>AS4QGIS Synthesis works best with the provided style files.&lt;br />Please ensure that you have downloaded them either via the GitHub link below or via the algorithms &lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; color:#000000;&quot;>“Help”&lt;/span>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;> button from the official AS4QGIS website, and that you have linked them to the corresponding outputs in the Processing Toolbox by right-clicking the algorithm and selecting &lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600; color:#000000;&quot;>“Edit Rendering Styles for Outputs”&lt;/span>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>Vertices → AS4QGIS_pointstyles.qml&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>Pointdata → AS4QGIS_pointstyles.qml&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>Polylines → AS4QGIS_polylinestyles.qml&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt; color:#000000;&quot;>Polygons → AS4QGIS_polygonstyles.qml&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:12pt; color:#000000;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:14pt; font-weight:600;&quot;>AS4QGIS V.1.0.0 Psyche&lt;/span>&lt;/p>&#xa;&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-size:12pt;&quot;>The AS4QGIS suite includes the complementary algorithm &amp;quot;&lt;/span>&lt;span style=&quot; font-size:12pt; font-weight:600;&quot;>Psyche&lt;/span>&lt;span style=&quot; font-size:12pt;&quot;>&amp;quot;. It equips existing polylines and polygons—from sources like CAD datasets or features digitized from georeferenced 3D models—with the same attributes generated by the main Synthesis algorithm. This allows for easy harmonization and seamless merging of multi-source data. The Help button links to the website where this algorithm can be downloaded.&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:12pt;&quot;>&lt;br />&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:12pt;&quot;>&lt;br />&lt;/p>&lt;/body>&lt;/html>" name="ALG_DESC"/>
    <Option type="QString" value="" name="ALG_HELP_CREATOR"/>
    <Option type="QString" value="V.1.2.0 Synthesis" name="ALG_VERSION"/>
    <Option type="QString" value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'.AppleSystemUIFont'; font-size:13pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;a href=&quot;https://github.com/archsurv4qgis/ArchSurv4QGIS&quot;>&lt;span style=&quot; text-decoration: underline; color:#0068da;&quot;>https://github.com/archsurv4qgis/ArchSurv4QGIShttps://github.com/archsurv4qgis/ArchSurv4QGIS&lt;/span>&lt;/a>&lt;/p>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; text-decoration: underline; color:#0068da;&quot;>&lt;br />&lt;/p>&lt;/body>&lt;/html>" name="EXAMPLES"/>
    <Option type="QString" value="https://www.archsurv4qgis.com/workflow" name="HELP_URL"/>
    <Option type="QString" value="ArchSurv4QGIS Synthesis is an open source solution for automated archaeological feature drawings from in-field GNSS / totalstation point measurements via QGIS.&#xa;It is designed as an adjustable &quot;.model3&quot; algorithm pipeline." name="SHORT_DESCRIPTION"/>
    <Option type="QString" value="This dropdown selects the attribute column of the input layer that contains the &quot;ArchSurv string&quot;&#xa;" name="archsurvstring"/>
    <Option type="QString" value="This dropdown (optional) selects the attribute column of the input layer that contains the &quot;Code&quot;, an optional attribute field, often exported from surveying devices alongside the Point ID.&#xa;In AS4QGIS, it can be used to classify features (e.g., by trench or feature type).&#xa;" name="code"/>
    <Option type="QString" value="ArchSurv4QGIS Synthesis processes delimited Text imported into QGIS as point data with X, Y, and Z values ​​using the &quot;Delimited Text&quot; import function. The file format and the delimiter type of the exported file from the surveying device are insignificant. The exported file should simply be in a format generally readable by QGIS (e.g., .csv, .txt, .asc, etc.) and contain a &quot;point_ID&quot; attribute and a &quot;code&quot; attribute:&#xa;&#xa;- &quot;point_ID&quot; contains the &quot;ArchSurv-String&quot;&#xa;&#xa;- &quot;code&quot; contains additional feature-information&#xa;&#xa;_&#xa;Import-Example:&#xa;field_1,field_2,field_3,field_4,field_5 &#xa;0041B03001,-126.449,356175.921,165.040,GR&#xa;0041B03002,-126.506,356175.712,165.086,GR&#xa;0041B03003,-126.486,356175.569,165.098,GR&#xa;0041B03004,-126.304,356175.481,165.069,GR&#xa;0041B03005,-126.183,356175.558,165.074,GR&#xa;0041B03006,-126.079,356175.638,165.055,GR&#xa;0041B03007,-126.087,356175.784,165.039,GR&#xa;0041B03008,-126.171,356175.929,165.045,GR&#xa;0041B03009,-126.260,356176.052,165.073,GR&#xa;0041B03010,-126.377,356175.997,165.056,GR&#xa;0041A01001,-126.247,356175.891,165.028,GR&#xa;&#xa;//Note 1: Here, &quot;field_1&quot; is equivalent with &quot;point_ID&quot; containing the &quot;ArchSurv-String&quot;&#xa;//Note 2: Here, &quot;field_5&quot; is equivalent with &quot;code&quot; containing the additional feature information.&#xa;" name="import"/>
    <Option type="QString" value="This checkbox enables the mirroring of polygons as closed lines in the polylines output.&#xa;" name="mirror_polygon_geometries_to_polylines"/>
    <Option type="QString" value="This output layer lists all Point-IDs that occur more than once in the input dataset, along with their occurrence count. If empty, all Point-IDs are unique and no action is required.&#xa;If the layer contains features, open the original survey file and reassign the line-container letter (position 5 of the ArchSurv-String) to the next available letter for each affected measurement group before re-running the algorithm.&#xa;Example: 0041A03001 (×3) → 0041A03001 / 0041B03001 / 0041C03001" name="point_id_conflicts"/>
    <Option type="QString" value="includes &quot;shptypes&quot; | '00', '01', '51', '71', '81', '91'" name="pointdata"/>
    <Option type="QString" value="includes &quot;shptypes&quot; | '03', '53', '61', '73', '93'" name="polygons"/>
    <Option type="QString" value="includes &quot;shptypes&quot; | '00', '02', '33', '52', '72', '92'&#xa;if checkbox &quot;mirror polygon geometries to polylines is checked&quot;, also includes | '03', '53', '61', '73', '93'" name="polylines"/>
    <Option type="QString" value="All measurement points that do not serve any further function than being vertex points of polylines or polygons." name="vertices"/>
  </Option>
  <Option type="QString" value="Version2" name="internal_version"/>
