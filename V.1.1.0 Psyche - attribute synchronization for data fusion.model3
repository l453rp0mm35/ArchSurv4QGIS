    <Option type="Map">
      <Option value="230,224,181,255" type="QString" name="color"/>
      <Option value="AS4QGIS - ArchSurv for QGIS (by Thomas Leutgeb)&#xa;V.1.0.0 - Psyche" type="QString" name="component_description"/>
      <Option value="42.83193928949876" type="double" name="component_height"/>
