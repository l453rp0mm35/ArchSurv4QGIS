    <Option type="Map">
      <Option value="" type="QString" name="color"/>
      <Option value="E. Connect Paths" type="QString" name="component_description"/>
      <Option value="152.43715803872152" type="double" name="component_height"/>
      <Option value="1174.6245247455977" type="double" name="component_pos_x"/>
      <Option value="558.9038856978341" type="double" name="component_pos_y"/>
      <Option value="1110.1545154675766" type="double" name="component_width"/>
      <Option value="true" type="bool" name="outputs_collapsed"/>
      <Option value="true" type="bool" name="parameters_collapsed"/>
      <Option value="{d3af064b-417a-4e51-9d44-dda74b9b2792}" type="QString" name="uuid"/>
    </Option>
    <Option type="Map">
      <Option value="230,220,204,255" type="QString" name="color"/>
      <Option value="&#xa;How to Use&#xa;&#xa;1 - Load your data: Import your line or polygon layer with Z-values into QGIS&#xa;&#xa;2 - Select the layer: Choose your input layer in the Input_Layer parameter&#xa;&#xa;3 - Identify your ID field: Select which field contains your identifier information&#xa;&#xa;4 - Choose the format: Select how your identifiers are structured (separate fields or combined with underscore)&#xa;&#xa;5 - Add Code field if needed: If using separate ID and Code fields, select the Code field&#xa;&#xa;6 - Run: Execute the algorithm and specify where to save the output&#xa;&#xa;7 - Result: Your features now have standardized attributes compatible with Synthesis outputs for merging and further analysis" type="QString" name="component_description"/>
      <Option value="431.7913080480521" type="double" name="component_height"/>
      <Option value="324.9476344277128" type="double" name="component_pos_x"/>
      <Option value="1995.8305923052997" type="double" name="component_pos_y"/>
      <Option value="571.2865485350778" type="double" name="component_width"/>
      <Option value="true" type="bool" name="outputs_collapsed"/>
      <Option value="true" type="bool" name="parameters_collapsed"/>
      <Option value="{e2fa1d0b-b2ea-4cb7-82e9-7b27cfa15ffe}" type="QString" name="uuid"/>
    </Option>
  </Option>
  <Option type="Map" name="help">
    <Option value="Thomas Leutgeb, Stadtarchäologie Wien" type="QString" name="ALG_CREATOR"/>
    <Option value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'.AppleSystemUIFont'; font-size:13pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-weight:600;&quot;>V.1.1.0 Psyche&lt;/span> is a &lt;span style=&quot; text-decoration: underline;&quot;>data harmonization tool&lt;/span> within the &lt;span style=&quot; text-decoration: underline;&quot;>ArchSurv4QGIS suite&lt;/span>. &lt;/p>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>Its primary function is to equip existing line or polygon data from heterogeneous sources (e.g., CAD plans, digitized 3D models, third-party GIS exports) with the same standardized attribute schema generated by the main V.1.1.9 Synthesis algorithm. It enables the seamless merging and unified analysis of archaeological survey data, regardless of its original creation method. It ensures data consistency for cartography, interpretation, and database integration.&lt;/p>&lt;/body>&lt;/html>" type="QString" name="ALG_DESC"/>
    <Option value="" type="QString" name="ALG_HELP_CREATOR"/>
    <Option value="V.1.0.0 Psyche" type="QString" name="ALG_VERSION"/>
    <Option value="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'.AppleSystemUIFont'; font-size:13pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;br />&lt;/p>&lt;/body>&lt;/html>" type="QString" name="EXAMPLES"/>
    <Option value="https://www.archsurv4qgis.com/workflow" type="QString" name="HELP_URL"/>
    <Option value="Harmonizes external line/polygon data to the ArchSurv4QGIS attribute standard for seamless data fusion." type="QString" name="SHORT_DESCRIPTION"/>
    <Option value="Attribute field containing code values: &#xa;Required when: Identifier_Composition is set to 'ID'+'Code'; &#xa;Not processed when: Using 'ID_Code' or 'Code_ID' formats; &#xa;Default: If not provided when using 'ID'+'Code' format, code values will be set to '---'." type="QString" name="code_field"/>
    <Option value="Contains the primary identifier data in one of three supported formats: &#xa;1. &quot;ID&quot;+&quot;Code&quot; (e.g., '1' or '0001'); 2. &quot;ID_Code&quot; (e.g., '1_VF'); 3. &quot;Code_ID&quot; (e.g., 'F7_1')" type="QString" name="id_field"/>
    <Option value="Structure of identifiers in the input data: Must match the selected ID_Field format of the selected Input_Layer.&#xa;&#xa;&#xa;" type="QString" name="identifier_composition"/>
    <Option value="Layer containing features to process:&#xa;Vector layer (Line or Polygon geometry); &#xa;Requirement: Must contain Z-values (elevation data)" type="QString" name="input_layer"/>
    <Option value="Processed layer with added attributes; &#xa;Geometry type: Same as input (Lines or Polygons); &#xa;Added attributes: ID, code, shptype, maxH, minH, maxHtemp, minHtemp, originfile, of_epsg, ID_code, code_ID." type="QString" name="psyche_output"/>
  </Option>
  <Option value="Version2" type="QString" name="internal_version"/>
  <Option name="modelVariables"/>
  <Option value="AS4QGIS" type="QString" name="model_group"/>
  <Option value="V.1.1.0 Psyche - attribute synchronization for data fusion" type="QString" name="model_name"/>
  <Option value="charted_spatial_records" type="QString" name="outputGroup"/>
  <Option type="StringList" name="outputOrder">
    <Option value="native:refactorfields_4:OUTPUT" type="QString"/>
  </Option>
  <Option type="Map" name="parameterDefinitions">
    <Option type="Map" name="code_field">
