      <Option value="{7377ec82-8da2-4f56-a8f8-35778b257d93}" type="QString" name="uuid"/>
    </Option>
    <Option type="Map">
      <Option value="253,191,111,255" type="QString" name="color"/>
      <Option value="&#xa;Purpose:&#xa;&#xa;Psyche complements the AS4QGIS 1.1.9 Synthesis algorithm by adding the same attribute structure to existing line or polygon measurements that Synthesis generates from point data. This enables seamless merging of different survey datasets.&#xa;&#xa;_____________________________&#xa;&#xa;Background:&#xa;&#xa;While total station fieldwork produces only point measurements that Synthesis processes according to their &quot;ArchSurv-String&quot; and &quot;Code&quot; Values into points, polylines, and polygons in-office, it's common to have polylines and polygons created by other means—such as digitizing on georeferenced 3D models or importing existing CAD files. Psyche standardizes these datasets to match the Synthesis output format.&#xa;&#xa;&#xa;_____________________________&#xa;&#xa;What the Algorithm Does:&#xa;&#xa;Psyche processes line and polygon features with Z-values to generate:&#xa;&#xa;- Standardized ID and Code fields from various identifier formats&#xa;- Elevation attributes (maxH, minH) calculated from geometry vertices&#xa;- Temporal pseudo-dates (maxHtemp, minHtemp) for visualization in QGIS temporal controller&#xa;- Geometry type classification (shptype: 2=Line, 3=Polygon)&#xa;- Formatted identifier strings (IDstring, ID_code, code_ID)&#xa;- Layer metadata (originfile, of_epsg)&#xa;&#xa;The result is a dataset with the same attribute structure as Synthesis outputs, allowing different survey data sources to be combined and analyzed together seamlessly." type="QString" name="component_description"/>
      <Option value="709.6260022017307" type="double" name="component_height"/>
      <Option value="325.435862827914" type="double" name="component_pos_x"/>
      <Option value="1413.8675100119142" type="double" name="component_pos_y"/>
      <Option value="569.6653482321699" type="double" name="component_width"/>
      <Option value="true" type="bool" name="outputs_collapsed"/>
      <Option value="true" type="bool" name="parameters_collapsed"/>
      <Option value="{93928469-d22a-481b-82d4-ed88633d28a0}" type="QString" name="uuid"/>
    </Option>
    <Option type="Map">
      <Option value="51,160,44,255" type="QString" name="color"/>
      <Option value="Python-Version: 3.9.5&#xa;" type="QString" name="component_description"/>
      <Option value="49.79897408730454" type="double" name="component_height"/>
      <Option value="325.7910711543982" type="double" name="component_pos_x"/>
      <Option value="610.8580083075461" type="double" name="component_pos_y"/>
      <Option value="564.9585771159495" type="double" name="component_width"/>
      <Option value="true" type="bool" name="outputs_collapsed"/>
