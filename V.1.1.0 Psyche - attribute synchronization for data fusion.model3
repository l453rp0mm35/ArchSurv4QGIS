        <Option value="Generates a pseudo-date 'maxHtemp' from the maximum elevation value. The integer part is interpreted as the year (plus 1000), the decimal part determines the month (in 100-unit steps). Enables temporal visualization in QGIS." type="QString" name="component_description"/>
        <Option value="202.28742666931635" type="double" name="component_height"/>
        <Option value="1196.0195911831893" type="double" name="component_pos_x"/>
        <Option value="1465.1895842427862" type="double" name="component_pos_y"/>
        <Option value="197.1566129239825" type="double" name="component_width"/>
        <Option value="true" type="bool" name="outputs_collapsed"/>
        <Option value="true" type="bool" name="parameters_collapsed"/>
      </Option>
      <Option value="G.1 - Generate Temporal Date from maxH" type="QString" name="component_description"/>
      <Option value="111.3488081059551" type="double" name="component_height"/>
      <Option value="858.6141767022355" type="double" name="component_pos_x"/>
      <Option value="1488.9727328006604" type="double" name="component_pos_y"/>
      <Option value="226.69709191450917" type="double" name="component_width"/>
      <Option name="dependencies"/>
      <Option value="native:fieldcalculator_6" type="QString" name="id"/>
      <Option name="outputs"/>
      <Option value="true" type="bool" name="outputs_collapsed"/>
      <Option value="true" type="bool" name="parameters_collapsed"/>
      <Option type="Map" name="params">
        <Option type="List" name="FIELD_LENGTH">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="0" type="int" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_NAME">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="maxHtemp" type="QString" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_PRECISION">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="0" type="int" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_TYPE">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="3" type="int" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FORMULA">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="make_date(&#xa;    to_int(substr(to_string(&quot;maxH&quot; + 1000), 1, 4)),&#xa;    CASE &#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 100 THEN 1&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 200 THEN 2&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 300 THEN 3&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 400 THEN 4&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 500 THEN 5&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 600 THEN 6&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 700 THEN 7&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 800 THEN 8&#xa;        WHEN to_int(right(rpad(to_string(&quot;maxH&quot; + 1000), 8, '0'), 3)) &lt; 900 THEN 9&#xa;        ELSE 10&#xa;    END,&#xa;    1&#xa;)" type="QString" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
          <Option type="Map">
            <Option value="native:joinattributestable_3" type="QString" name="child_id"/>
            <Option value="OUTPUT" type="QString" name="output_name"/>
            <Option value="1" type="int" name="source"/>
          </Option>
        </Option>
      </Option>
    </Option>
